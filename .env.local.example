# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── App ───────────────────────────────────────────────────────────────────────
# URL de ce projet (callbacks WebAuthn, OAuth, emails)
NEXT_PUBLIC_APP_URL=https://chainscore-auth.vercel.app

# URL de l'application principale après connexion utilisateur
NEXT_PUBLIC_MAIN_APP_URL=https://chainscore-app.vercel.app

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email de l'administrateur (toi) — utilisé pour le routage /admin
# Doit correspondre exactement à l'email du compte Supabase admin
ADMIN_EMAIL=ton@email.com

# ── WebAuthn ──────────────────────────────────────────────────────────────────
# Doit correspondre à l'origine du navigateur (sans slash final)
WEBAUTHN_RP_ID=chainscore-auth.vercel.app
WEBAUTHN_RP_NAME=MyChainScore

# ── OAuth Providers ───────────────────────────────────────────────────────────
# Ces clés sont configurées dans le dashboard Supabase > Authentication > Providers
# Les variables ci-dessous sont indicatives — Supabase gère OAuth côté serveur.
# 1. Google : https://console.cloud.google.com > APIs > Credentials
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
#
# 2. GitHub : https://github.com/settings/developers > OAuth Apps
# GITHUB_CLIENT_ID=xxxx
# GITHUB_CLIENT_SECRET=xxxx
#
# 3. Apple : https://developer.apple.com > Certificates > Keys
# APPLE_CLIENT_ID=com.mychainscore.auth
# APPLE_SECRET_KEY_ID=xxxx
# APPLE_TEAM_ID=xxxx
# (clé privée .p8 à uploader dans le dashboard Supabase)
#
# → Pour activer chaque provider : Supabase Dashboard > Authentication > Providers
#   Colle ton Client ID + Secret, et configure l'URL de callback :
#   https://xxxxxxxxxxxxxxxxxxxx.supabase.co/auth/v1/callback

# ── Stripe (Bloc 2) ───────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# STRIPE_PRICE_ID=price_...
